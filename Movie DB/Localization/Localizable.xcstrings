    "legal.legalNotice %@" : {
      "comment" : "The legal notice in the legal view. The parameter is the legal e-mail address.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Inhalte und Bilder sind Eigentum ihrer entsprechenden Besitzer.\nFür rechtliche Fragen, kontaktieren Sie bitte %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All content and images are properties of their respective owners.\nFor legal concerns, contact %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo el contenido y las imágenes pertenecen a sus respectivos propietarios.\nPara consultas legales, escribe a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les contenus et toutes les images appartiennent à leurs propriétaires respectifs.\nPour toute question juridique, contacte %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i contenuti e le immagini appartengono ai rispettivi proprietari.\nPer questioni legali, contatta %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのコンテンツと画像の権利は、それぞれの所有者に帰属します。\n法的なお問い合わせは%@までご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 콘텐츠와 이미지는 각 소유자의 자산입니다.\n법적 문의: %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystkie treści i obrazy są własnością ich odpowiednich właścicieli.\nW sprawach prawnych skontaktuj się z %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo o conteúdo e as imagens pertencem aos respectivos proprietários.\nPara questões legais, entre em contato pelo e-mail %@."
          }
        }
      }
    },
