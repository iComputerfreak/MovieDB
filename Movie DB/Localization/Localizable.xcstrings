    "legal.analyticsIdentifier.description" : {
      "comment" : "Explanation for why the analytics installation identifier is shown.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib diese ID bei Datenschutzanfragen an, damit Analytics-Daten deiner App-Installation zugeordnet werden können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Include this ID in privacy requests so analytics data can be matched to your app installation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluye este ID en las solicitudes de privacidad para poder asociar los datos analíticos con tu instalación de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique cet identifiant dans tes demandes relatives à la confidentialité afin que les données d’analyse puissent être associées à ton installation de l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includi questo ID nelle richieste relative alla privacy, così i dati di analisi potranno essere associati all’installazione della tua app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー関連のリクエストにこのIDを記載すると、分析データをアプリのインストール情報と照合できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 보호 요청에 이 ID를 포함하면 분석 데이터를 앱 설치와 연결할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dołącz ten identyfikator do wniosków dotyczących prywatności, aby można było powiązać dane analityczne z instalacją aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua este ID em solicitações de privacidade para que os dados de análise possam ser associados à instalação do seu app."
          }
        }
      }
    },
