    "lists.customList.emptyState.description" : {
      "comment" : "The description of the empty state of a custom list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Hinzufügen von Medien\nden Eintrag gedrückt halten\nund “Hinzufügen...” auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add media to this list by\nlong pressing on a media object\nand selecting 'Add to List'."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes añadir contenido a esta lista\nmanteniendo pulsado un elemento\ny seleccionando «Añadir a una lista»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux ajouter des médias à cette liste en\nappuyant longuement sur un média,\npuis en sélectionnant « Ajouter à une liste »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi aggiungere contenuti a questo elenco\ntenendo premuto un contenuto\ne selezionando “Aggiungi a un elenco”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアを長押しして\n「リストに追加」を選ぶと、\nこのリストに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미디어를 길게 누른 다음\n'목록에 추가'를 선택해\n이 목록에 추가할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz dodać treść do tej listy,\nprzytrzymując ją i wybierając\n„Dodaj do listy”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode adicionar mídias a esta lista\nmantendo uma mídia pressionada\ne selecionando 'Adicionar à lista'."
          }
        }
      }
    },
