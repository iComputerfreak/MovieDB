    "settings.analytics.summary" : {
      "comment" : "Summary explaining the analytics policy in settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft, Bildschirm- und Funktionsnutzung mit PostHog zu verstehen. Es werden keine Titel, Notizen, Tags, Bewertungen oder Suchtexte gesendet. IP-Adressen werden nicht gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helps understand screen and feature usage with PostHog. No titles, notes, tags, ratings, or search text are sent. IP addresses are not stored."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a entender el uso de pantallas y funciones con PostHog. No se envían títulos, notas, etiquetas, valoraciones ni texto de búsqueda. Las direcciones IP no se almacenan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à comprendre l’utilisation des écrans et des fonctionnalités avec PostHog. Aucun titre, aucune note, aucun tag, aucune évaluation ni aucun texte de recherche n’est envoyé. Les adresses IP ne sont pas stockées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta a capire l’utilizzo delle schermate e delle funzioni tramite PostHog. Non vengono inviati titoli, note, tag, valutazioni o testo di ricerca. Gli indirizzi IP non vengono memorizzati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostHogを使って画面や機能の利用状況を把握します。タイトル、メモ、タグ、評価、検索テキストは送信されません。IPアドレスは保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PostHog를 통해 화면과 기능 사용 현황을 파악합니다. 제목, 메모, 태그, 평점, 검색어는 전송하지 않으며 IP 주소도 저장하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomaga zrozumieć korzystanie z ekranów i funkcji za pomocą PostHog. Nie są wysyłane tytuły, notatki, tagi, oceny ani tekst wyszukiwania. Adresy IP nie są przechowywane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda a entender o uso de telas e recursos com o PostHog. Nenhum título, nota, etiqueta, avaliação ou texto de busca é enviado. Endereços IP não são armazenados."
          }
        }
      }
    },
