    "apiError.updateError.description" : {
      "comment" : "Description of the TMDb API error that occurs during updating of the media objects",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehler beim aktualisieren der Medien. Wenn dieser Fehler weiterhin besthet, versuchen Sie bitte die Mediathek in den Einstellungen neu zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error updating the media. If this issue persists, please try to reload the library in the settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al actualizar el contenido. Si el problema persiste, prueba a recargar la biblioteca desde los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur lors de la mise à jour des médias. Si le problème persiste, essaie de recharger la bibliothèque depuis Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Errore durante l’aggiornamento dei contenuti. Se il problema persiste, prova a ricaricare la libreria nelle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メディアを更新できませんでした。問題が続く場合は、設定からライブラリを再読み込みしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미디어를 업데이트할 수 없습니다. 문제가 계속되면 설정에서 보관함을 다시 불러오세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Błąd aktualizacji treści. Jeśli problem będzie się powtarzać, spróbuj ponownie wczytać bibliotekę w ustawieniach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erro ao atualizar as mídias. Se o problema persistir, tente recarregar a biblioteca nos ajustes."
          }
        }
      }
    },
