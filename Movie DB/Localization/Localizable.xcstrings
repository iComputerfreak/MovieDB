    "changelog.titleImport.description" : {
      "comment" : "Description of the changelog item announcing title-based CSV import",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere eine vorhandene Film- oder Serienliste anhand der Titel und optionaler Angaben wie Jahr, Regie oder Laufzeit in Movie DB. Prüfe die Treffer vor dem Import. Du findest den neuen Import in den Einstellungen unter „Import & Export“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring an existing movie or show list into Movie DB using titles and optional details such as year, director, or runtime. Review the matches before importing them. You can find the new import in Settings under Import & Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa en Movie DB una lista existente de películas o series mediante sus títulos y datos opcionales como el año, la dirección o la duración. Revisa las coincidencias antes de importarlas. Encontrarás la nueva importación en Ajustes, dentro de Importar y exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe dans Movie DB une liste existante de films ou de séries à partir des titres et d’informations facultatives comme l’année, le réalisateur ou la durée. Vérifie les correspondances avant de les importer. Tu trouveras cette nouvelle fonction d’importation dans Réglages, sous Importation et exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa in Movie DB un elenco esistente di film o serie usando i titoli e dettagli facoltativi come anno, regista o durata. Controlla le corrispondenze prima di importarle. Trovi la nuova funzione nelle Impostazioni, sotto Importazione ed esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルと、年、監督、上映時間などの任意情報を使って、既存の映画や番組リストをMovie DBに取り込めます。インポート前に一致結果を確認できます。新しいインポート機能は「設定」の「インポートとエクスポート」にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목을 기준으로 기존 영화나 TV 프로그램 목록을 Movie DB로 가져올 수 있습니다. 필요하면 연도, 감독, 상영 시간 같은 세부 정보도 사용할 수 있습니다. 가져오기 전에 일치 결과를 검토하세요. 새로운 가져오기 기능은 설정의 가져오기 및 내보내기에서 찾을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś istniejącą listę filmów lub seriali do Movie DB, używając tytułów i opcjonalnych danych, takich jak rok, reżyser lub czas trwania. Przejrzyj dopasowania przed importem. Nową funkcję importu znajdziesz w Ustawieniach w sekcji Import i eksport."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe para o Movie DB uma lista existente de filmes ou séries usando títulos e detalhes opcionais, como ano, direção ou duração. Revise as correspondências antes de importá-las. Você encontra o novo recurso em Ajustes, em Importação e exportação."
          }
        }
      }
    },
