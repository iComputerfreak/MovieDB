    "tips.libraryRow.message" : {
      "comment" : "The message to display in the tip for the library row setting.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jetzt auswählen, welche Informationen in der dritten Zeile der Bibliotheksliste angezeigt werden sollen.\nSchauen Sie sich Option 'Streaminganbieter' an!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can now choose, what information to display in the third line of the library list.\nCheck out the 'Streaming services' option!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora puedes elegir qué información mostrar en la tercera línea de la lista de la biblioteca.\n¡Prueba la opción «Servicios de streaming»!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux maintenant choisir les informations à afficher sur la troisième ligne de la bibliothèque.\nDécouvre l’option « Services de streaming » !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ora puoi scegliere quali informazioni visualizzare nella terza riga dell’elenco della libreria.\nProva l’opzione “Servizi di streaming”!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブラリ一覧の3行目に表示する情報を選べるようになりました。\n「動画配信サービス」も試してみてください！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 보관함 목록의 세 번째 줄에 표시할 정보를 선택할 수 있습니다.\n'스트리밍 서비스' 옵션을 확인해 보세요!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
