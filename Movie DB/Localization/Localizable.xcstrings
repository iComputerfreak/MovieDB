    "settings.analyticsConsent.message" : {
      "comment" : "Intro text on the analytics consent sheet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App kann mit PostHog anonyme Nutzungsstatistiken senden, um zu verstehen, welche Bereiche nützlich sind und wo Reibung entsteht. IP-Adressen werden nicht gespeichert. Die Daten helfen nur bei Produktverbesserungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app can use PostHog to send anonymous usage statistics to understand which parts are useful and where friction happens. IP addresses are not stored. The data is only used to improve the product."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app puede usar PostHog para enviar estadísticas de uso anónimas y entender qué partes resultan útiles y dónde surgen dificultades. Las direcciones IP no se almacenan. Los datos solo se usan para mejorar el producto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app peut utiliser PostHog pour envoyer des statistiques d’utilisation anonymes afin de comprendre quelles parties sont utiles et où des difficultés surviennent. Les adresses IP ne sont pas stockées. Ces données servent uniquement à améliorer le produit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa app può usare PostHog per inviare statistiche di utilizzo anonime e capire quali parti sono utili e dove si verificano difficoltà. Gli indirizzi IP non vengono memorizzati. I dati vengono usati solo per migliorare il prodotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリはPostHogに匿名の利用統計を送信し、役立つ機能や使いにくい箇所を把握できます。IPアドレスは保存されません。データは製品改善のみに使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱은 PostHog로 익명 사용 통계를 전송해 유용한 부분과 불편한 부분을 파악할 수 있습니다. IP 주소는 저장하지 않으며 데이터는 제품 개선에만 사용됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta aplikacja może używać PostHog do wysyłania anonimowych statystyk użytkowania, aby ustalić, które elementy są przydatne i gdzie występują trudności. Adresy IP nie są przechowywane. Dane służą wyłącznie do ulepszania produktu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este app pode usar o PostHog para enviar estatísticas de uso anônimas e entender quais partes são úteis e onde há dificuldades. Endereços IP não são armazenados. Os dados são usados somente para melhorar o produto."
          }
        }
      }
    },
